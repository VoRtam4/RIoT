#
# This .env file contains definitions of environent varibles
# used across multiple Docker-compose services.
# Single-service scoped environent varibles are
# defined in the 'environent' section of each service.
#

# PostgreSQL configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB_NAME=postgres-db

# InfluxDB configuration
INFLUX_USER=user
INFLUX_PASSWORD=password
INFLUX_ORGANIZATION=jiap
INFLUX_BUCKET=jiap-time-series
INFLUX_TOKEN=Fgp2ozMxmkYnUBkzwLpkx6ydOVXyQqF4-ZPctGjv8-xkirYPYRvoBtrpAHMCr_joYoJMOqZjl8djjuyOx-MR_A==
INFLUX_URL=http://influxdb:8086
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=Fgp2ozMxmkYnUBkzwLpkx6ydOVXyQqF4-ZPctGjv8-xkirYPYRvoBtrpAHMCr_joYoJMOqZjl8djjuyOx-MR_A==

# RabbitMQ configuration
RABBITMQ_USER=riot
RABBITMQ_PASSWORD=secret
RABBITMQ_URL=amqp://riot:secret@rabbitmq:5672

# Runtime data stored outside Docker volumes and outside /mnt/c bind mounts
RIOT_DOCKER_DATA_DIR=/home/user/riot-docker-data

# Worker configuration
MPU_INPUT_WORKERS=1
MPU_INTERNAL_INPUT_BUFFER=1000
MPU_INPUT_PAUSE_HIGH_WATERMARK_PERCENT=80
MPU_INPUT_RESUME_LOW_WATERMARK_PERCENT=50
MPU_INPUT_SOURCE_PAUSE_HIGH_WATERMARK_PERCENT=50
MPU_INPUT_SOURCE_RESUME_LOW_WATERMARK_PERCENT=25
MPU_INPUT_PAUSE_CHECK_INTERVAL_MS=200
MPU_INPUT_TREND_SAMPLE_INTERVAL_MS=5000
MPU_INPUT_WATCH_PRESSURE_THRESHOLD=0.1
MPU_INPUT_DROP_CANDIDATE_PRESSURE_THRESHOLD=0.5
MPU_INPUT_DROP_CANDIDATE_BACKLOG_DELTA_THRESHOLD=1
MPU_INPUT_STATE_ESCALATION_SAMPLES=3
MPU_INPUT_STATE_RECOVERY_SAMPLES=3
MPU_INPUT_DROPPER_ENABLED=false
MPU_INPUT_DROPPER_GRACE_SAMPLES=3
REPROCESS_WORKERS=2
INFLUX_READ_WORKERS=4

# Remaining properties
BACKEND_CORE_URL=http://backend-core:9090
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
AUTH_REDIRECT_URL=http://localhost:8080/auth/callback
ROOT_ADMIN_EMAIL=vojtah105@gmail.com
GOOGLE_OAUTH2_CLIENT_ID=759574217041-q7mc1ggb34kj1l5ukqm4l1k59n5h6bhe.apps.googleusercontent.com
