#
# This .env file contains definitions of environent varibles
# used across multiple Docker-compose services.
# Single-service scoped environent varibles are
# defined in the 'environent' section of each service.
#

# PostgreSQL configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB_NAME=postgres-db

# InfluxDB configuration
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=password
INFLUXDB_ORG=riot
INFLUXDB_BUCKET=riot-bucket
INFLUXDB_TOKEN=513c5778-7682-4216-a7ce-9ab0eb79efb0

# RabbitMQ configuration
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Remaining properties
BACKEND_CORE_URL=http://riot-backend-core:9090
